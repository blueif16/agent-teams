# Crusoe Managed Inference key. Wrap in single quotes: keys can contain `$`.
CRUSOE_API_KEY=''
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# LangSmith tracing for Deep Agents runs (smith.langchain.com → Settings → API keys).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=''
LANGSMITH_PROJECT=agent-teams
# Optional: force one model for every agent (otherwise each agent uses its own).
# CRUSOE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
